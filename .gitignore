# ───────────────────────────────────────────────────────────────────────
# OMRCheckerMoE — gitignore
# Maintained alongside the May-2026 directory rename. Old folder names
# (custom_25_definitive_final, portrait_25q, prefill_only_package, etc.)
# are kept here too so a partial checkout never accidentally tracks
# legacy artefacts that survive on a contributor's disk.
# ───────────────────────────────────────────────────────────────────────

# Any directory starting with a dot
**/\.*/
!.github/

# Python bytecode + caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.idea/
.vscode/
*.code-workspace
**/.DS_Store

# Wiki mirrors
OMRChecker.wiki/

# ── Batch + user data ──────────────────────────────────────────────────
webui/storage/
inputs/*
outputs/*
!inputs/.gitkeep
!outputs/.gitkeep

# ── PyInstaller build artefacts ────────────────────────────────────────
build/
dist/
*.spec.bak
build_log.txt
build_output.txt

# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log

# ── Benchmark / profiling outputs (kept out of git; use benchmarks/ dir) ─
benchmarks/results/
benchmark_results*/
bench_*.json
robustness_*.json
benchmark_*.py
run_*_benchmark.py

# ── One-off scripts that drop output in the repo root ──────────────────
extract_*.py
*_Results_*.csv

# ── OMR engine runtime / scratch ───────────────────────────────────────
**/_runtime/
samples/**/outputs/
diagnostic_output/
omr_stress_artifacts/

# ── Prefill package: generated PDFs + benchmark CSVs ──────────────────
prefill_package/outputs/
prefill_package/benchmark_*.csv
prefill_package/sample_outputs/
# Legacy name kept for safety on stale checkouts:
prefill_only_package/outputs/
prefill_only_package/benchmark_*.csv

# ── Generated PDFs / PNGs inside preset folders ────────────────────────
# (regenerable; the source JPG/template is what's authoritative)
MoE-April-2026-Landscape-NNQ25-0/*.pdf
MoE-April-2026-Landscape-NNQ25-0/blank_legacy_landscape_answer_sheet_with_markers.png
MoE-April-2026-Portrait-NNQ25-0/*.pdf
MoE-May-2026-Variants-SMQ25-0/reference/*.pdf
# Legacy names:
custom_25_definitive_final/*.pdf
custom_25_definitive_final/*.png
old_custom25_answer_sheet_v1/*.pdf

# ── Portrait-25Q sweep harness scratch ─────────────────────────────────
MoE-May-2026-Variants-SMQ25-0/variants/sweep/runs/
MoE-May-2026-Variants-SMQ25-0/variants/sweep/reference_test/
MoE-May-2026-Variants-SMQ25-0/variants/sweep/results/
# Legacy paths:
portrait_25q/variants/sweep/runs/
portrait_25q/variants/sweep/reference_test/
portrait_25q/variants/sweep/results/

# ── Generated workflow diagram PNG (source = .excalidraw) ──────────────
docs/architecture/NERS_OMR_Workflow.png
NERS_OMR_Workflow.png
